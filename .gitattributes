# werk is a byte-exact format project: a spec file whose line endings change
# between checkouts has a different sha256, and sha256 is the store key.
# Everything is LF in the working tree and in the repository, on every OS.
* text=auto eol=lf

# The specification and the bootstrap loaders are HASHED CONTENT of every
# package a builder writes (spec_sha256, every files[].sha256), so their bytes
# must be the repository's in EVERY clone, whatever core.autocrlf, core.eol or
# the platform says. `text=auto` leaves the text/binary decision to git's
# heuristic; for these trees it is not a heuristic: they are text, LF, always
# (finding N1 of the release evidence: the paper's fixtures had been built
# from a working tree whose spec files were CRLF, and no clone could
# reproduce them). The binary examples under spec/examples/ are restored to
# binary by the extension rules below, which come later and therefore win.
spec/** text eol=lf
loaders/** text eol=lf
plugins/blender/werk_blender/spec/** text eol=lf
plugins/blender/werk_blender/vendor/** text eol=lf
# The libraries vendor the same spec/ + loaders/ bytes (libs/bundle and the
# Python package's copy) and the plug-ins vendor the single-file libraries.
libs/bundle/** text eol=lf
libs/python/werk/bundle/** text eol=lf
libs/python/werk_single.py text eol=lf
libs/js/dist/** text eol=lf

# Payload fixtures are bytes and are never translated.
*.png binary
*.wav binary
*.glb binary
*.werk binary
*.bin binary
*.wkff binary
*.wkrp binary
*.wkac binary
*.wksk binary
*.wkem binary
*.wkgs binary
*.wkpc binary
*.zip binary

# The conformance fixture is HASHED CONTENT, not source. Every byte under
# tests/fixtures/ is covered by a sha256 inside that package's own
# MANIFEST.json, so a single normalised line ending anywhere in it would break
# verification on checkout. Bytes are bytes here, including the JSON and the
# markdown.
tests/fixtures/** binary

# The golden sample is HASHED CONTENT too, for the same reason.
fixtures/*.werk binary

# Stage 6's test corpus is HASHED CONTENT: tests/run_gate_6.py pins the sha256
# of every downloaded file and refuses to run against different bytes, and
# fixtures/humanoid-retarget-v1.werk hashes 02_01.bvh inside its own manifest.
# 02_01.bvh and cmu-READMEFIRST.txt arrive with CRLF and MUST keep it -- one
# normalised line ending on checkout and both checks fail, on the machine that
# did nothing wrong.
retarget/testdata/** binary

# Plug-ins: the Office profile definitions are copied byte for byte into the
# packages werk-office writes (their hashes are in those manifests), and the
# remaining binary payload kinds the plug-ins carry.
plugins/office/profiles/** binary
*.zlib binary
*.wkx binary
*.wkxz binary
*.uasset binary
