import sys
import json
import hashlib
from zipfile import ZipFile

def sha256_hex(data):
    """Compute SHA256 of data and return hex string."""
    h = hashlib.sha256()
    h.update(data)
    return h.hexdigest()

def extract_file(zipf, name, output_path):
    """Extract file from zip to disk."""
    with open(output_path, 'wb') as f:
        f.write(zipf.read(name))

