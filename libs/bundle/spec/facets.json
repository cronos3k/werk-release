{
  "registry": "werk-facets",
  "version": 1,
  "created": "2026-08-08T00:00:00Z",
  "description": "The semantic tag vocabulary for werk profile 3d-entity/1. This registry travels inside every package that uses it, so a tag written today still means the same thing when read by a tool that has never heard of werk. Validated by spec/schemas/facets.schema.json; consumed by spec/schemas/core.semantics.schema.json. Tags are deliberately generic and setting-neutral: they describe what a thing looks like, does, and is made of, never which franchise it belongs to.",

  "rules": {
    "tag_pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "free_tag_prefix": "x.",
    "unknown_tag_behavior": "A tag that is not in this registry and does not start with 'x.' is INVALID and a validator MUST report it. A tag that starts with 'x.' is always valid, is never validated further, and MUST be preserved by any tool that rewrites a package. Free tags are how a vocabulary grows: they are collected from the wild and promoted into a later registry version, never invented in a schema.",
    "multi_tag": "A facet declared cardinality 'many' may carry several tags. A facet declared cardinality 'one' should carry at most one; a package carrying two is not malformed, but a consumer picking a single value MUST take the first, because arrays are ordered by significance.",
    "case": "kebab-case, ASCII lowercase, digits allowed, single hyphens between segments, no leading or trailing hyphen. This matches conventions.id_case in the manifest.",
    "ordering": "Within a facet array, tags are ordered most significant first. A single-tag user interface shows index 0.",
    "deprecation": "A tag is never removed. It moves into the facet's 'deprecated' map with its replacement, stays valid forever, and readers MAY map it forward. Removing a tag would break files that are already signed, which law 12 forbids."
  },

