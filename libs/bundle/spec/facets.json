      "tag_meta": {
        "microscopic": {"gloss": "below the resolution of the naked eye", "longest_axis_min_m": 0.0, "longest_axis_max_m": 0.0001, "example": "a spore"},
        "dust": {"gloss": "debris that behaves as a particle, not a body", "longest_axis_min_m": 0.0001, "longest_axis_max_m": 0.003, "example": "a wood splinter"},
        "tiny": {"gloss": "picked up between two fingers", "longest_axis_min_m": 0.003, "longest_axis_max_m": 0.03, "example": "a coin, a screw"},
        "handheld": {"gloss": "held comfortably in one hand", "longest_axis_min_m": 0.03, "longest_axis_max_m": 0.3, "example": "a mug, a pistol"},
        "small": {"gloss": "carried in two hands", "longest_axis_min_m": 0.3, "longest_axis_max_m": 0.8, "example": "a toolbox, a rifle"},
        "medium": {"gloss": "human-scale object, moved with effort", "longest_axis_min_m": 0.8, "longest_axis_max_m": 2.0, "example": "a crate, a chair, a door"},
        "large": {"gloss": "taller or wider than a person", "longest_axis_min_m": 2.0, "longest_axis_max_m": 4.0, "example": "a wardrobe, a market stall"},
        "oversized": {"gloss": "needs machinery to move", "longest_axis_min_m": 4.0, "longest_axis_max_m": 8.0, "example": "a shipping container"},
        "huge": {"gloss": "dominates a room", "longest_axis_min_m": 8.0, "longest_axis_max_m": 15.0, "example": "a small aircraft"},
        "room-sized": {"gloss": "is itself an enclosable space", "longest_axis_min_m": 15.0, "longest_axis_max_m": 30.0, "example": "a hangar bay module"},
        "vehicle-sized": {"gloss": "large craft or rolling stock", "longest_axis_min_m": 30.0, "longest_axis_max_m": 100.0, "example": "a locomotive, a freighter hull section"},
        "building-sized": {"gloss": "architecture", "longest_axis_min_m": 100.0, "longest_axis_max_m": 500.0, "example": "a tower"},
        "monumental": {"gloss": "a landmark visible across a district", "longest_axis_min_m": 500.0, "longest_axis_max_m": 5000.0, "example": "a dam, an arcology spire"},
