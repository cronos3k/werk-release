 "texts": {
  "license_unestablished": "LICENCE TERMS NOT ESTABLISHED\n\nThis package was written by a werk library writer on behalf of whoever ran\nit. That person, or the tool that called the library, decides the terms\nunder which the content of this package is offered; none were given to the\nwriter, and this file says so instead of inventing some. The werk format\nrecords licence facts and enforces none (spec/SPEC.md section 2, `license`).\n\nThe specification under spec/ and the readers under loaders/ are not the\ncontent of this package. They are the format, copied unchanged, and they\nkeep the terms they carry.\n",
  "readme": "This is a werk package. Everything needed to read it is inside it.\n\nStart with spec/README.md. loaders/ holds single-file, dependency-free\nreaders in Python, Rust and C; any one of them lists the nodes and verifies\nevery hash:\n\n    python loaders/werk_read.py <this file> --verify\n\nMANIFEST.json lists every file, its sha256 and the node it belongs to.\n",
  "spec_note": "The format specification, its schemas and its binary layout grammars, travelling inside the file they describe (law 2).",
  "loader_note": "A single-file, dependency-free reader for this package, carried as payload so the file brings its own reader (law 1).",
  "license_note": "The licence statement, embedded in full, never a link (law 7).",
  "readme_note": "One page for a human who opened the archive by hand."
 },
 "head_order": [
  "MANIFEST.json",
  "SIGNATURE.json",
  "LICENSE",
  "README.txt",
  "loaders/",
  "spec/"
 ],
